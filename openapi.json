    "/api/history/": {
      "get": {
        "tags": [
          "Chat History"
        ],
        "summary": "Get chat history",
        "description": "Return chat history belonging to the authenticated user. Results may optionally be restricted to one document.",
        "operationId": "get_history_api_history__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of chat records to return.",
              "default": 5,
              "title": "Limit"
            },
            "description": "Maximum number of chat records to return."
          },
          {
            "name": "document_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional document ID used to restrict history to one document.",
              "title": "Document Id"
            },
            "description": "Optional document ID used to restrict history to one document."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatHistoryListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Chat History"
        ],
        "summary": "Clear chat history",
        "description": "Delete chat history belonging to the authenticated user. Deletion may optionally be restricted to one document.",
        "operationId": "clear_history_api_history__delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional document ID used to clear history for one document only.",
              "title": "Document Id"
            },
            "description": "Optional document ID used to clear history for one document only."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearChatHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
