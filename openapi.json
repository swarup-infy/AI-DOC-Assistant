            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login_api_auth_login_post"
      },
      "Body_upload_file_api_upload_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Document to upload. Supported formats are PDF, DOCX, TXT, CSV, XLSX, and XLS."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_upload_file_post"
      },
      "ChatHistoryListResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatHistoryResponse"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "total"
        ],
        "title": "ChatHistoryListResponse",
        "description": "Collection of stored chat-history records."
      },
      "ChatHistoryResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "User Id"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "title": "Answer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "document",
              "groq",
              "smart"
            ],
            "title": "Mode"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "question",
          "answer",
          "mode",
          "created_at",
          "updated_at"
        ],
        "title": "ChatHistoryResponse",
        "description": "Public representation of one stored chat interaction."
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Question",
            "description": "User question."
          },
          "mode": {
            "type": "string",
            "enum": [
              "document",
              "groq",
              "smart"
            ],
            "title": "Mode",
            "description": "Chat processing mode.",
            "default": "document"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id",
            "description": "Optional document ID used to restrict chat to a specific uploaded document."
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "description": "Request payload for AI chat.\n\nModes:\n- document: Answer using uploaded document context.\n- groq: Answer directly using the configured Groq LLM.\n- smart: Use document context when relevant and Groq otherwise."
      },
      "ChatResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "title": "Answer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "document",
              "groq",
              "smart"
            ],
            "title": "Mode"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "answer",
          "mode"
        ],
        "title": "ChatResponse",
        "description": "Response returned by the AI chat endpoint."
      },
      "ClearChatHistoryResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "deleted_records": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Deleted Records"
          }
        },
        "type": "object",
        "required": [
          "message",
          "deleted_records"
        ],
        "title": "ClearChatHistoryResponse",
        "description": "Response returned after clearing chat history."
      },
      "DashboardLastUpload": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "uploaded_at"
        ],
        "title": "DashboardLastUpload",
        "description": "Most recently uploaded document."
      },
      "DashboardRecentChat": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "question",
          "created_at"
        ],
        "title": "DashboardRecentChat",
        "description": "Recent chat activity shown on the dashboard."
      },
      "DashboardResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "statistics": {
            "$ref": "#/components/schemas/DashboardStatistics"
          },
          "last_upload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DashboardLastUpload"
              },
              {
                "type": "null"
              }
            ]
          },
          "recent_chats": {
            "items": {
              "$ref": "#/components/schemas/DashboardRecentChat"
            },
            "type": "array",
            "title": "Recent Chats"
          }
        },
        "type": "object",
        "required": [
          "statistics"
        ],
        "title": "DashboardResponse",
        "description": "Dashboard data returned for the authenticated user."
      },
      "DashboardStatistics": {
        "properties": {
          "total_documents": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Documents",
            "description": "Total number of documents owned by the user."
          },
          "total_chats": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Chats",
            "description": "Total number of stored chat interactions."
          },
          "storage_used_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Storage Used Bytes",
            "description": "Total document storage used in bytes."
          },
          "storage_used_mb": {
            "type": "number",
            "minimum": 0.0,
            "title": "Storage Used Mb",
            "description": "Total document storage used in megabytes."
          }
        },
        "type": "object",
        "required": [
          "total_documents",
          "total_chats",
          "storage_used_bytes",
          "storage_used_mb"
        ],
        "title": "DashboardStatistics",
        "description": "Aggregate statistics for the authenticated user's dashboard."
      },
      "DocumentResponse": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "description": "Original uploaded filename."
          },
          "file_type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "File Type",
            "description": "Document file extension."
          },
          "file_size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "File Size",
            "description": "File size in bytes."
          },
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "file_type",
          "file_size",
          "id",
          "uploaded_at",
          "updated_at"
        ],
        "title": "DocumentResponse",
        "description": "Document information returned to the client."
